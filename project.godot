; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SFB:GO"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

Events="*res://autoload/events.gd"
Net="*res://autoload/net.gd"
Match="*res://autoload/match.gd"
Settings="*res://autoload/settings.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/vsync/vsync_mode=0

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
crouch={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194326)]
}
walk={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
fire={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
secondary={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2)]
}
ability={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
reload={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
melee={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":86)]
}
weapon_primary={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
weapon_secondary={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
class_menu={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":66)]
}
scoreboard={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194306)]
}
pause_menu={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="hitbox"
3d_physics/layer_4="projectile"
3d_physics/layer_5="pickup"
3d_physics/layer_6="grapple"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
