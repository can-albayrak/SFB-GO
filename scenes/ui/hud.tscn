[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="1_hud"]
[ext_resource type="Script" path="res://scripts/ui/crosshair.gd" id="2_crosshair"]
[ext_resource type="Script" path="res://scripts/ui/scoreboard.gd" id="3_scoreboard"]
[ext_resource type="Script" path="res://scripts/ui/kill_feed.gd" id="4_killfeed"]
[ext_resource type="Script" path="res://scripts/ui/loadout_menu.gd" id="5_loadout"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Crosshair" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("2_crosshair")

[node name="KillFeed" type="VBoxContainer" parent="."]
layout_mode = 3
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -520.0
offset_top = 14.0
offset_right = -18.0
offset_bottom = 160.0
grow_horizontal = 0
mouse_filter = 2
theme_override_constants/separation = 2
script = ExtResource("4_killfeed")

[node name="Scoreboard" type="PanelContainer" parent="."]
layout_mode = 3
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -360.0
offset_top = -200.0
offset_right = 360.0
offset_bottom = 200.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("3_scoreboard")

[node name="VBox" type="VBoxContainer" parent="Scoreboard"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Scoreboard/VBox"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "FREE FOR ALL"

[node name="Grid" type="GridContainer" parent="Scoreboard/VBox"]
layout_mode = 2
theme_override_constants/h_separation = 30
theme_override_constants/v_separation = 6
columns = 4

[node name="FlashOverlay" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(1, 1, 1, 0)

[node name="LoadoutMenu" type="PanelContainer" parent="."]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -500.0
offset_top = 230.0
offset_right = 500.0
offset_bottom = 550.0
grow_horizontal = 2
script = ExtResource("5_loadout")
