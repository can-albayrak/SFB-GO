[gd_resource type="Resource" script_class="ClassDef" format=3]

[ext_resource type="Script" path="res://scripts/defs/class_def.gd" id="1_class"]
[ext_resource type="Script" path="res://scripts/defs/weapon_def.gd" id="2_wdef"]
[ext_resource type="Resource" path="res://data/weapons/heavy_rifle.tres" id="3_heavy"]
[ext_resource type="Resource" path="res://data/weapons/marksman_rifle.tres" id="4_marksman"]
[ext_resource type="Resource" path="res://data/weapons/pistol.tres" id="5_pistol"]
[ext_resource type="Resource" path="res://data/movement/standard.tres" id="6_move"]
[ext_resource type="Resource" path="res://data/weapons/knife.tres" id="7_knife"]
