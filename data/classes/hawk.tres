[resource]
script = ExtResource("1_class")
id = &"hawk"
display_name = "Hawk"
max_health = 80
move_speed = 6.6
movement = ExtResource("6_move")
primary_weapons = Array[ExtResource("2_wdef")]([ExtResource("3_heavy"), ExtResource("4_marksman")])
secondary_weapon = ExtResource("5_pistol")
abilities = Array[ExtResource("8_adef")]([ExtResource("9_grapple"), ExtResource("10_decoy")])
quick_melee = ExtResource("7_knife")
