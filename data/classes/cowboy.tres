[gd_resource type="Resource" script_class="ClassDef" format=3]

[ext_resource type="Script" path="res://scripts/defs/class_def.gd" id="1_class"]
[ext_resource type="Script" path="res://scripts/defs/weapon_def.gd" id="2_wdef"]
[ext_resource type="Resource" path="res://data/weapons/musket.tres" id="3_musket"]
[ext_resource type="Resource" path="res://data/weapons/revolver.tres" id="4_revolver"]
[ext_resource type="Resource" path="res://data/movement/standard.tres" id="5_move"]
[ext_resource type="Resource" path="res://data/weapons/knife.tres" id="6_knife"]
