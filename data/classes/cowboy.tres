[resource]
script = ExtResource("1_class")
id = &"cowboy"
display_name = "Cowboy"
max_health = 100
move_speed = 6.6
movement = ExtResource("5_move")
primary_weapons = Array[ExtResource("2_wdef")]([ExtResource("3_musket")])
secondary_weapon = ExtResource("4_revolver")
abilities = Array[ExtResource("7_adef")]([ExtResource("8_smoke")])
quick_melee = ExtResource("6_knife")
knife = ExtResource("6_knife")
