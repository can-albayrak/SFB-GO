[resource]
script = ExtResource("1_class")
id = &"bear"
display_name = "Bear"
max_health = 200
move_speed = 6.3
movement = ExtResource("7_move")
primary_weapons = Array[ExtResource("2_wdef")]([ExtResource("3_hammer"), ExtResource("4_claws"), ExtResource("5_saw")])
secondary_weapon = ExtResource("6_throw")
abilities = Array[ExtResource("9_adef")]([ExtResource("10_shield"), ExtResource("11_charge")])
quick_melee = ExtResource("8_kick")
