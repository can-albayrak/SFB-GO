[gd_resource type="Resource" script_class="ClassDef" format=3]

[ext_resource type="Script" path="res://scripts/defs/class_def.gd" id="1_class"]
[ext_resource type="Script" path="res://scripts/defs/weapon_def.gd" id="2_wdef"]
[ext_resource type="Resource" path="res://data/weapons/sledgehammer.tres" id="3_hammer"]
[ext_resource type="Resource" path="res://data/weapons/claws.tres" id="4_claws"]
[ext_resource type="Resource" path="res://data/weapons/chainsaw.tres" id="5_saw"]
[ext_resource type="Resource" path="res://data/weapons/throwing_knives.tres" id="6_throw"]
[ext_resource type="Resource" path="res://data/movement/standard.tres" id="7_move"]
