[gd_resource type="Resource" script_class="ClassDef" format=3]

[ext_resource type="Script" path="res://scripts/defs/class_def.gd" id="1_class"]
[ext_resource type="Script" path="res://scripts/defs/weapon_def.gd" id="2_wdef"]
[ext_resource type="Resource" path="res://data/weapons/assault_rifle.tres" id="3_ar"]
[ext_resource type="Resource" path="res://data/weapons/pistol.tres" id="4_pistol"]
[ext_resource type="Resource" path="res://data/movement/standard.tres" id="5_move"]
[ext_resource type="Resource" path="res://data/weapons/burst_rifle.tres" id="6_burst"]
[ext_resource type="Resource" path="res://data/weapons/lmg.tres" id="7_lmg"]
[ext_resource type="Resource" path="res://data/weapons/knife.tres" id="8_knife"]
