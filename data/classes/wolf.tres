[ext_resource type="Resource" path="res://data/abilities/flashbang.tres" id="11_flash"]

[resource]
script = ExtResource("1_class")
id = &"wolf"
display_name = "Wolf"
max_health = 100
move_speed = 6.6
movement = ExtResource("5_move")
primary_weapons = Array[ExtResource("2_wdef")]([ExtResource("3_ar"), ExtResource("6_burst"), ExtResource("7_lmg")])
secondary_weapon = ExtResource("4_pistol")
abilities = Array[ExtResource("9_adef")]([ExtResource("10_frag"), ExtResource("11_flash")])
quick_melee = ExtResource("8_knife")
