[resource]
script = ExtResource("1_class")
id = &"volcano"
display_name = "Volcano"
max_health = 110
move_speed = 6.2
movement = ExtResource("6_move")
primary_weapons = Array[ExtResource("2_wdef")]([ExtResource("3_shotgun"), ExtResource("4_launcher")])
secondary_weapon = ExtResource("5_pistol")
abilities = Array[ExtResource("8_adef")]([ExtResource("9_sticky"), ExtResource("10_mine")])
quick_melee = ExtResource("7_knife")
