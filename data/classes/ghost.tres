[resource]
script = ExtResource("1_class")
id = &"ghost"
display_name = "Ghost"
max_health = 80
move_speed = 7.0
movement = ExtResource("4_move")
primary_weapons = Array[ExtResource("2_wdef")]([ExtResource("10_mp5sd")])
secondary_weapon = ExtResource("6_secondary")
abilities = Array[ExtResource("3_adef")]([ExtResource("11_cloak")])
quick_melee = ExtResource("5_knife")
knife = ExtResource("5_knife")
silent_steps = true
