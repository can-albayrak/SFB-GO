[gd_resource type="Resource" script_class="ClassDef" format=3]

[ext_resource type="Script" path="res://scripts/defs/class_def.gd" id="1_class"]
[ext_resource type="Script" path="res://scripts/defs/weapon_def.gd" id="2_wdef"]
[ext_resource type="Script" path="res://scripts/defs/ability_def.gd" id="3_adef"]
[ext_resource type="Resource" path="res://data/movement/standard.tres" id="4_move"]
[ext_resource type="Resource" path="res://data/weapons/knife.tres" id="5_knife"]
[ext_resource type="Resource" path="res://data/weapons/deagle.tres" id="6_secondary"]
[ext_resource type="Resource" path="res://data/weapons/assault_rifle.tres" id="10_assault_rifle"]
[ext_resource type="Resource" path="res://data/weapons/shotgun.tres" id="11_shotgun"]
[ext_resource type="Resource" path="res://data/abilities/dice.tres" id="12_dice"]

[resource]
script = ExtResource("1_class")
id = &"gambler"
display_name = "Gambler"
max_health = 95
move_speed = 6.6
movement = ExtResource("4_move")
primary_weapons = Array[ExtResource("2_wdef")]([ExtResource("10_assault_rifle"), ExtResource("11_shotgun")])
secondary_weapon = ExtResource("6_secondary")
abilities = Array[ExtResource("3_adef")]([ExtResource("12_dice")])
quick_melee = ExtResource("5_knife")
knife = ExtResource("5_knife")
